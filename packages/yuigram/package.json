{
  "name": "yuigram",
  "version": "0.0.0",
  "description": "Independent TypeScript framework for the Telegram Bot API and MTProto",
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-bot-api",
    "mtproto",
    "userbot",
    "bot",
    "typescript",
    "framework"
  ],
  "license": "MIT",
  "homepage": "https://github.com/yuigram/yuigram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuigram/yuigram.git",
    "directory": "packages/yuigram"
  },
  "bugs": {
    "url": "https://github.com/yuigram/yuigram/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js",
      "default": "./dist/webhook.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@yuigram/bot-api": "workspace:*",
    "@yuigram/core": "workspace:*"
  }
}
