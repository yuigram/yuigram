{
  "name": "@yuigram/core",
  "version": "0.1.0",
  "description": "Transport-agnostic framework core for Yuigram: dispatch, middleware, filters, context, sessions, storage",
  "keywords": [
    "telegram",
    "telegram-bot",
    "framework",
    "middleware",
    "dispatch",
    "typescript",
    "yuigram"
  ],
  "license": "MIT",
  "author": "coupdev <193032786+coupdev@users.noreply.github.com>",
  "homepage": "https://github.com/yuigram/yuigram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuigram/yuigram.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yuigram/yuigram/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js",
      "default": "./dist/format/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js",
      "default": "./dist/stream/index.js"
    },
    "./dice": {
      "types": "./dist/dice/index.d.ts",
      "import": "./dist/dice/index.js",
      "default": "./dist/dice/index.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb/index.d.ts",
      "import": "./dist/indexeddb/index.js",
      "default": "./dist/indexeddb/index.js"
    }
  },
  "browser": {
    "./dist/storage/file.js": "./dist/storage/file.browser.js",
    "./dist/storage/encrypted.js": "./dist/storage/encrypted.browser.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  }
}
