{
  "name": "@yuigram/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Transport-agnostic framework core for Yuigram: dispatch, middleware, filters, context, sessions, storage",
  "license": "MIT",
  "homepage": "https://github.com/yuigram/yuigram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuigram/yuigram.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
