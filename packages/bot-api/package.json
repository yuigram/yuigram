{
  "name": "@yuigram/bot-api",
  "version": "0.0.0",
  "type": "module",
  "description": "Telegram Bot API subsystem for Yuigram",
  "license": "MIT",
  "homepage": "https://github.com/yuigram/yuigram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuigram/yuigram.git",
    "directory": "packages/bot-api"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
