{
  "name": "@yuigram/bot-api",
  "version": "1.0.0",
  "description": "Telegram Bot API subsystem for Yuigram",
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-bot-api",
    "bot",
    "webhook",
    "polling",
    "typescript",
    "yuigram"
  ],
  "license": "MPL-2.0",
  "author": "coupdev <193032786+coupdev@users.noreply.github.com>",
  "homepage": "https://github.com/yuigram/yuigram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuigram/yuigram.git",
    "directory": "packages/bot-api"
  },
  "bugs": {
    "url": "https://github.com/yuigram/yuigram/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook/index.d.ts",
      "import": "./dist/webhook/index.js",
      "default": "./dist/webhook/index.js"
    },
    "./markup": {
      "types": "./dist/markup/index.d.ts",
      "import": "./dist/markup/index.js",
      "default": "./dist/markup/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js",
      "default": "./dist/stream/index.js"
    },
    "./rich": {
      "types": "./dist/rich/index.d.ts",
      "import": "./dist/rich/index.js",
      "default": "./dist/rich/index.js"
    },
    "./web-app": {
      "types": "./dist/web-app/index.d.ts",
      "import": "./dist/web-app/index.js",
      "default": "./dist/web-app/index.js"
    }
  },
  "browser": {
    "./dist/files-node.js": "./dist/files-node.browser.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@yuigram/core": "workspace:*"
  }
}
