# Copy to .env in this directory and fill in. The .env file is ignored by Git.
# Every value below is a placeholder; none is a real credential.
# The file is read from this directory wherever the commands are run from, and a
# variable already set in the environment wins over it. Relative paths below are
# taken from this directory.

# Which Telegram environment BOTH clients use: production or test.
# A test-environment bot comes from that environment's @BotFather, and a
# test-environment account is a test account. The two environments share nothing.
TELEGRAM_ENV=production

# The bot's token, from @BotFather of the chosen environment.
BOT_TOKEN=123456:REPLACE_WITH_THE_BOT_TOKEN

# The Telegram user id of the one person allowed to give commands.
# login.ts prints the account's own id; the bot tells anyone who writes to it theirs.
OPERATOR_ID=0

# The application's credentials, from https://my.telegram.org (API development tools).
API_ID=0
API_HASH=REPLACE_WITH_THE_API_HASH

# Telegram's server public keys for the chosen environment, in PEM, as Telegram's
# MTProto documentation publishes them and the application page on my.telegram.org
# shows them beside the server addresses. They are public; the file is yours to create.
# With this value it is examples/20-presence-watch/telegram-keys.pem.
SERVER_KEYS=./telegram-keys.pem

# Optional. The first datacenter address; the defaults are datacenter 2 of the chosen environment.
# DC_ID=2
# DC_HOST=149.154.167.50
# DC_PORT=443

# Optional. Where state is kept: account/ is the signed-in account, watch/ the watch list.
# The default is examples/20-presence-watch/state.
# DATA_DIR=./state

# Optional. Seconds between reads (never under 30) and how many users may be watched (never over 20).
# POLL_SECONDS=60
# WATCH_LIMIT=10

# Optional. The time zone times are written in, e.g. Europe/Moscow. The system's unless given.
# TIME_ZONE=Europe/Moscow
